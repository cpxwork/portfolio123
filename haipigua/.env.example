# Copy this file to .env in the haipigua folder, then fill in your own key.
# .env is ignored by Git. Never commit it or paste the key into the browser.
MODEL_PROVIDER=aiping
MODEL_API_KEY=
MODEL_NAME=GLM-4.7-Flash

# Conservative local estimate stop line. Not a platform hard limit.
MODEL_BUDGET_CNY=2
MODEL_MAX_TURNS=60

# AI Ping uses JSON mode by default. Uncomment only if the selected model
# supports native OpenAI tools and you explicitly want to try them.
# MODEL_TOOLS=1
# MODEL_JSON_MODE=0

# Product server. Keep HOST on loopback for personal use.
PORT=8877
HOST=127.0.0.1

# Public deployment only: set the exact browser origin behind your
# authenticated reverse proxy, and ALLOW_PUBLIC=1 if HOST is not loopback.
# APP_ORIGIN=https://haipigua.example.com
# ALLOW_PUBLIC=0
